# VeriLabel — local environment (NOT committed to git)
# Copy this to .env.local and fill in your real API key.
# .env.local is gitignored; never commit it.

# Provider: openai-compatible | azure-openai | gemini
AI_PROVIDER=openai-compatible

# Base URL for the OpenAI-compatible Chat Completions endpoint.
AI_BASE_URL=https://api.openai.com/v1

# Your API key (vision-capable model required). Fill this in.
AI_API_KEY=

# A fast vision model. Examples: gpt-4o-mini, gpt-4o, gemini-1.5-flash
AI_MODEL=gpt-4o-mini

# Timeout (ms) for a single AI call.
AI_TIMEOUT_MS=30000